{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 120,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "src/styles.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": ["package-lock.json", "pnpm-lock.yaml", "yarn.lock", "src/routeTree.gen.ts"]
}
