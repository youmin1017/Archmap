# Copy to .env (git-ignored). Defaults match deploy/compose/compose.yaml.
POSTGRES_USER=archmap
POSTGRES_PASSWORD=archmap
POSTGRES_DB=archmap
POSTGRES_PORT=5432

# API
API_ADDR=:8080
DATABASE_URL=postgres://archmap:archmap@localhost:5432/archmap?sslmode=disable
LOG_LEVEL=info
CORS_ALLOW_ORIGINS=http://localhost:3000

# Dev only: identify the caller with an "X-Dev-User: <email>" header (seeded users) until session auth exists.
AUTH_DEV_HEADER=true

# Let a maintainer approve and merge their own changeset (protected-element changes still need a second maintainer).
MERGE_ALLOW_SELF=false

# Web dev server: which seeded user the /api proxy acts as (viewer@ / editor@ / maintainer@archmap.local).
DEV_USER=viewer@archmap.local
