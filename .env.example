# Copy to .env (git-ignored). Defaults match deploy/compose/compose.yaml.
POSTGRES_USER=archmap
POSTGRES_PASSWORD=archmap
POSTGRES_DB=archmap
POSTGRES_PORT=5432

# API
API_ADDR=:8080
DATABASE_URL=postgres://archmap:archmap@localhost:5432/archmap?sslmode=disable
LOG_LEVEL=info
CORS_ALLOW_ORIGINS=http://localhost:3000

# development | test | production (the default when unset). Development-only switches below
# make the API refuse to start in any other environment.
APP_ENV=development

# Development sign-in: pick a seeded account on the login page without a password (development only).
AUTH_DEV_LOGIN=true
# Cookies without Secure / __Host- so they work over http://localhost (development only).
COOKIE_SECURE=false
# Session lifetimes: idle timeout and absolute maximum age.
SESSION_IDLE_TIMEOUT=8h
SESSION_MAX_AGE=168h
# Who may sign in with a local password: all | maintainers (once single sign-on is the default).
AUTH_LOCAL_PASSWORD=all
# Proxies allowed to set X-Forwarded-For (CIDRs, comma separated); empty = use the peer address.
TRUSTED_PROXIES=

# Lint: how old an element review may be before "stale-review" warns (Go duration; 4320h = 180 days).
LINT_REVIEW_MAX_AGE=4320h

# Let a maintainer approve and merge their own changeset (protected-element changes still need a second maintainer).
MERGE_ALLOW_SELF=false

